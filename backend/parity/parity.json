{
  "_comment": "Routes come from ../openapi.yaml (GET operations, H-020 C1). This file only adds what the spec cannot say.",
  "examples": {
    "/api/job/{name}": [
      "/api/job/example"
    ],
    "/api/draft/{id}": [
      "/api/draft/1"
    ],
    "/api/run/{id}": [
      "/api/run/1"
    ],
    "/api/memory/e/{id}": [
      "/api/memory/e/1"
    ],
    "/api/briefs/{id}": [
      "/api/briefs/H-023"
    ],
    "/api/log/{key}": [
      "/api/log/t1",
      "/api/log/f1",
      "/api/log/f1?from=1"
    ],
    "/api/tasks/{id}": [
      "/api/tasks/1"
    ]
  },
  "queries": {
    "/api/search/results": [
      "?q=ports&project=homelab&type=&junk=1",
      "?q=a%20b~*&source=x"
    ]
  },
  "exclude": [
    "/static/{file}",
    "/api/session"
  ],
  "skip": [],
  "ignore": {
    "*": [
      "now",
      "generated_at",
      "csrf_token",
      "request_id"
    ],
    "/api/overview": [
      "x",
      "status.at"
    ]
  }
