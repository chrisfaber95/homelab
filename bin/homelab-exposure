#!/usr/bin/env bash
# homelab: exposure check (H-008). Home Assistant and every other published compose port must stay on the tailnet.
#   homelab-exposure --static   only the definition: compose.yaml publishes to the Tailscale address, in 8100-8199
#   homelab-exposure            also the real box: who listens, and that the LAN address refuses the port
# Also covers the H-012 services that listen on all addresses and rely on ufw plus their own client filter: the LLM
# router (8018), the search API (8019) and the homelab page (8105, with the Search tab). Static: every ufw allow rule in
# scripts/ is tailnet-only (SSH from the LAN excepted), each service opens its port on tailscale0 only, refuses clients
# outside loopback and the tailnet, and the inbox reaches them on loopback. Live: they listen, and a request from the
# box to its own LAN address is refused or answered 403.
# Output: one line per check, <OK|FAIL> <name> <text>. Exit 0 all OK, 1 at least one FAIL, 2 cannot run.
# Runs without root. Needs docker (compose config, no daemon) and jq; the live part needs ss and ip.
set -uo pipefail

REPO="$(dirname "$(dirname "$(readlink -f "$0")")")"
COMPOSE="${COMPOSE_FILE:-$REPO/compose.yaml}"
TS_IP="${TAILSCALE_IP:-100.85.70.34}"
live=1
[[ ${1:-} == --static ]] && live=0
for tool in docker jq; do
  command -v "$tool" >/dev/null || { echo "homelab-exposure: $tool is missing" >&2; exit 2; }
done
cfg=$(docker compose -f "$COMPOSE" config --format json 2>&1) || { echo "homelab-exposure: $cfg" >&2; exit 2; }

failed=0
report() { printf '%-4s  %-22s %s\n' "$1" "$2" "$3"; [[ $1 == FAIL ]] && failed=1; return 0; }

ports=()
# --- H-012 services (router, search API, homelab page): not in compose.yaml, so checked from the repo and live ---
cfg_port() { jq -r "$2" "$REPO/config/$1" 2>/dev/null; }
router_port=$(sed -n 's/^ROUTER_PORT=//p' "$REPO/config/llm.conf" 2>/dev/null | tr -d '"'); router_port=${router_port:-8018}
search_port=$(cfg_port search.json '.query.port // 8019'); search_port=${search_port:-8019}
inbox_port=$(sed -n 's/^INBOX_PORT=//p' "$REPO/config/inbox.conf" 2>/dev/null | tr -d '"'); inbox_port=${inbox_port:-8105}

bad_rules=$(grep -hnE '^[[:space:]]*ufw[[:space:]]+(allow|limit)' "$REPO"/scripts/*.sh \
  | grep -vE 'in on tailscale0' | grep -vE 'from "\$LAN_SUBNET" to any port 22 ' || true)
if [[ -n $bad_rules ]]; then
  report FAIL "exposure:ufw-rules" "ufw rule not limited to tailscale0: $(head -n1 <<<"$bad_rules")"
else
  report OK "exposure:ufw-rules" "every ufw allow in scripts/ is on tailscale0 (SSH from the LAN excepted)"
fi
# --- H-016 Discord bot: connects outward only, so it must have no listener, no ufw rule and no wildcard address ---
if grep -nE '\.listen\(|\.bind\(|HTTPServer|TCPSite|run_app|start_server|web\.Application' "$REPO"/discord-bot/*.py >/dev/null 2>&1; then
  report FAIL "exposure:discord-bot:no-listener" "discord-bot/ contains server code; the bot may only connect outward"
elif grep -vE '^[[:space:]]*#' "$REPO/scripts/26-discord-bot.sh" | grep -q ufw; then
  report FAIL "exposure:discord-bot:no-listener" "scripts/26-discord-bot.sh touches ufw; the bot opens no port"
else
  report OK "exposure:discord-bot:no-listener" "discord-bot/ has no server code and its script opens no port"
fi
check_service() {  # name port script server-file
  local name=$1 port=$2 script=$3 server=$4
  if grep -E 'ufw allow in on tailscale0 to any port' "$REPO/scripts/$script" | grep -qE "port \"?(\\\$[A-Z_]+|$port)\"? "; then
    report OK "exposure:$name:ufw" "scripts/$script opens the port on tailscale0 only"
  else
    report FAIL "exposure:$name:ufw" "scripts/$script has no 'ufw allow in on tailscale0 to any port' rule for it"
  fi
  if grep -q '100\.64\.0\.0/10' "$REPO/$server"; then
    report OK "exposure:$name:filter" "$server refuses clients outside loopback and 100.64.0.0/10"
  else
    report FAIL "exposure:$name:filter" "$server has no tailnet-only client filter"
  fi
}
check_service router "$router_port" 17-llm.sh llm/netutil.py
check_service search "$search_port" 24-search.sh search/server.py
for key in SEARCH_URL ROUTER_URL; do
  url=$(sed -n "s/^$key=//p" "$REPO/config/inbox.conf" | tr -d '"')
  if [[ $url =~ ^http://(127\.0\.0\.1|localhost)(:|/|$) ]]; then
    report OK "exposure:inbox:$key" "the page reaches it on loopback ($url)"
  else
    report FAIL "exposure:inbox:$key" "'$url' is not a loopback address; the Search tab must not call out to another host"
  fi
done
if grep -qE 'Access\.allowed|def allowed' "$REPO/bin/homelab_inbox/server.py" "$REPO/bin/homelab_inbox/pages.py" \
   && grep -q 'self.guard()' "$REPO/bin/homelab_inbox/server.py"; then
  report OK "exposure:inbox:guard" "every page and /api/search route sits behind the tailnet owner check"
else
  report FAIL "exposure:inbox:guard" "the inbox handler has no guard() owner check"
fi
svc_ports=("$router_port" "$search_port" "$inbox_port")
# --- H-018 kitt: the adapter listens on loopback only; the tailnet port is the gate in the inbox, which answers only the
#     owner's own devices (Access.allowed) and sits on the Tailscale address, inside 8100-8199 (ufw: tailscale0 only) ---
kitt_gate_port=$(sed -n 's/^KITT_GATE_PORT=//p' "$REPO/config/inbox.conf" | tr -d '"'); kitt_gate_port=${kitt_gate_port:-8121}
kitt_gate_host=$(sed -n 's/^KITT_GATE_HOST=//p' "$REPO/config/inbox.conf" | tr -d '"')
kitt_unit="$REPO/deploy/kitt.service"
kitt_port=$(sed -n 's/^Environment=KITT_PORT=//p' "$kitt_unit" 2>/dev/null)
if [[ $(sed -n 's/^Environment=KITT_HOST=//p' "$kitt_unit" 2>/dev/null) == 127.0.0.1 && $kitt_port =~ ^81[0-9][0-9]$ ]] \
   && ! grep -qE '^Environment=KITT_HOST=(0\.0\.0\.0|::|\*)' "$kitt_unit"; then
  report OK "exposure:kitt:adapter" "deploy/kitt.service: the adapter listens on 127.0.0.1:$kitt_port only"
else
  report FAIL "exposure:kitt:adapter" "deploy/kitt.service must set KITT_HOST=127.0.0.1 and a KITT_PORT in 8100-8199"
fi
if [[ $kitt_gate_host == "$TS_IP" && $kitt_gate_port =~ ^81[0-9][0-9]$ && $kitt_gate_port != "$kitt_port" ]]; then
  report OK "exposure:kitt:gate" "the gate listens on $kitt_gate_host:$kitt_gate_port only (KITT_GATE_HOST in config/inbox.conf)"
else
  report FAIL "exposure:kitt:gate" "KITT_GATE_HOST must be $TS_IP and KITT_GATE_PORT in 8100-8199, not the adapter's port"
fi
if grep -q 'Access.allowed' "$REPO/bin/homelab_inbox/gate.py" \
   && grep -qE 'ufw allow in on tailscale0 to any port 8100:8199' "$REPO/scripts/18-projects.sh"; then
  report OK "exposure:kitt:filter" "the gate runs the homelab page's owner check; 8100-8199 is open on tailscale0 only"
else
  report FAIL "exposure:kitt:filter" "gate.py has no Access.allowed check, or 18-projects.sh has no tailscale0-only rule for 8100-8199"
fi
if grep -q 'peer_uid' "$REPO/bin/homelab_inbox/kitt.py" && grep -q 'self.kitt_door' "$REPO/bin/homelab_inbox/server.py"; then
  report OK "exposure:kitt:door" "the inbox's kitt door checks the connection's account and Chris's identity"
else
  report FAIL "exposure:kitt:door" "the inbox's kitt door has no account check"
fi
ports+=("$kitt_gate_port")
svc_ports+=("$kitt_gate_port")

while IFS="|" read -r svc ip port; do
  name="exposure:$svc:$port"
  if [[ $ip == "$TS_IP" && $port =~ ^81[0-9][0-9]$ ]]; then
    report OK "$name" "published on $ip:$port only"
    ports+=("$port")
  else
    report FAIL "$name" "published on '${ip:-all addresses}' port $port; must be $TS_IP in 8100-8199"
  fi
done < <(jq -r '.services | to_entries[] | .key as $s | (.value.ports // [])[] | [$s, (.host_ip // ""), (.published // "")] | join("|")' <<<"$cfg")

while read -r svc mode; do
  report FAIL "exposure:$svc:network" "network_mode $mode: host networking would bypass the per-port bind address"
done < <(jq -r '.services | to_entries[] | select((.value.network_mode // "") == "host" or (.value.privileged // false)) | "\(.key) \(.value.network_mode // "privileged")"' <<<"$cfg")

if (( live )); then
  lan=$(ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p')
  for port in "${ports[@]}"; do
    listeners=$(ss -Htln "sport = :$port" | awk '{print $4}')
    if [[ -z $listeners ]]; then
      report FAIL "exposure:live:$port" "nothing listens on $port (is the service running?)"
      continue
    fi
    wrong=$(grep -v -x -F "$TS_IP:$port" <<<"$listeners" | grep -v -x -F "127.0.0.1:$port" || true)
    if [[ -n $wrong ]]; then
      report FAIL "exposure:live:$port" "listens on $(paste -sd' ' <<<"$wrong"), expected only $TS_IP:$port"
    else
      report OK "exposure:live:$port" "listens on $(paste -sd' ' <<<"$listeners") only"
    fi
    if [[ -n $lan && $lan != "$TS_IP" ]]; then
      if timeout 3 bash -c "exec 3<>/dev/tcp/$lan/$port" 2>/dev/null; then
        report FAIL "exposure:lan:$port" "$lan:$port (LAN address) accepts connections"
      else
        report OK "exposure:lan:$port" "$lan:$port (LAN address) refuses connections"
      fi
    fi
  done
fi

if (( live )) && [[ $kitt_port =~ ^[0-9]+$ ]]; then
  adapter=$(ss -Htln "sport = :$kitt_port" | awk '{print $4}')
  if [[ -z $adapter ]]; then
    report FAIL "exposure:live:$kitt_port" "nothing listens on $kitt_port (is kitt running?)"
  elif [[ $(grep -v -x -F "127.0.0.1:$kitt_port" <<<"$adapter" || true) ]]; then
    report FAIL "exposure:live:$kitt_port" "kitt's adapter listens on $(paste -sd' ' <<<"$adapter"), expected only 127.0.0.1:$kitt_port"
  else
    report OK "exposure:live:$kitt_port" "kitt's adapter listens on 127.0.0.1:$kitt_port only"
  fi
fi

if (( live )) && [[ -n ${lan:-} && $lan != "$TS_IP" ]]; then
  command -v curl >/dev/null || report FAIL "exposure:live:curl" "curl is missing, cannot probe the LAN address"
  for port in "${svc_ports[@]}"; do
    if [[ -z $(ss -Htln "sport = :$port" | awk '{print $4}') ]]; then
      report FAIL "exposure:live:$port" "nothing listens on $port (is the service running?)"
      continue
    fi
    code=$(curl -s -o /dev/null -m 5 -w '%{http_code}' "http://$lan:$port/" 2>/dev/null || true)
    if [[ $code == 000 || $code == 403 ]]; then
      report OK "exposure:lan:$port" "$lan:$port (LAN address) is refused (${code/000/no connection})"
    else
      report FAIL "exposure:lan:$port" "$lan:$port (LAN address) answered HTTP $code to a request from the LAN"
    fi
  done
fi
exit "$failed"
