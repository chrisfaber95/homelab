    "/api/log/{key}": ["/api/log/t1"],
    "/api/tasks/{id}": ["/api/tasks/1"]
  },
  "exclude": [
    "/static/{file}",
    "/api/session"
  ],
  "skip": [],
  "ignore": {
    "*": ["now", "generated_at", "csrf_token", "request_id"],
    "/api/live": ["activity"],
    "/api/overview": ["updated", "health"]
  }
