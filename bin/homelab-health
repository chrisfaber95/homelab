#!/usr/bin/env bash
# homelab: health check (F-016, uitgebreid in F-020). Driver/GPU, netwerk, schijf, pending reboot; en zodra ze
# geïnstalleerd zijn: de LLM-helper (F-017), de gedeployde diensten (F-018) en de backup (F-020).
# Exit 0: alles in orde (WARN mag). Exit 1: minstens één FAIL. Exit 2: de check zelf kan niet draaien.
# Eén regel per check: <OK|WARN|FAIL> <naam> <tekst>; elke naam komt één keer voor (homelab-monitor leest dat).
# Draait zonder root. Instellingen: config/health.conf (en llm.conf, backup.conf) naast bin/.
set -uo pipefail

CONFDIR="$(dirname "$(dirname "$(readlink -f "$0")")")/config"
CONF="$CONFDIR/health.conf"
if [[ ! -r "$CONF" ]]; then
  echo "Kan $CONF niet lezen." >&2
  exit 2
fi
# shellcheck source=../config/health.conf
source "$CONF"
if [[ ! "${EXPECTED_GPU:-}" =~ ^(.+),\ ([0-9]+)\ MiB$ ]]; then
  echo "EXPECTED_GPU in $CONF moet eruitzien als \"NVIDIA GeForce GTX 1080, 8192 MiB\"." >&2
  exit 2
fi
EXPECTED_GPU_NAME="${BASH_REMATCH[1]}"
EXPECTED_VRAM_MIB="${BASH_REMATCH[2]}"

failed=0
report() { # report OK|WARN|FAIL <check> <tekst>
  printf '%-4s  %-10s %s\n' "$1" "$2" "$3"
  [[ $1 == FAIL ]] && failed=1
  return 0
}

# --- Driver en GPU
if ! gpu=$(timeout 15 nvidia-smi --query-gpu=name,memory.total,memory.used,driver_version \
             --format=csv,noheader,nounits 2>&1); then
  report FAIL gpu "nvidia-smi faalt: ${gpu//$'\n'/ }"
else
  IFS=',' read -r name total used driver <<<"$(head -n1 <<<"$gpu")"
  name="${name# }"; total="${total// /}"; used="${used// /}"; driver="${driver// /}"
  if [[ "$name" != "$EXPECTED_GPU_NAME" ]]; then
    report FAIL gpu "$name gevonden, $EXPECTED_GPU_NAME verwacht (EXPECTED_GPU in $CONF)"
  elif (( total * 100 < EXPECTED_VRAM_MIB * 95 )); then
    report FAIL gpu "$name heeft $total MiB VRAM, $EXPECTED_VRAM_MIB MiB verwacht"
  else
    report OK gpu "$name, $total MiB ($used MiB in gebruik), driver $driver"
  fi
fi

# Elke geïnstalleerde kernel heeft kant-en-klare NVIDIA-modules nodig, anders werkt de GPU na de volgende reboot niet.
missing_mod=()
for img in /boot/vmlinuz-*; do
  kver="${img#/boot/vmlinuz-}"
  if ! dpkg-query -W -f='${Status}\n' "linux-modules-nvidia-*-$kver" 2>/dev/null | grep -q 'install ok installed'; then
    missing_mod+=("$kver")
  fi
done
if (( ${#missing_mod[@]} )); then
  report FAIL nvidia-mod "geen linux-modules-nvidia-* voor kernel ${missing_mod[*]}"
else
  report OK nvidia-mod "modules voor elke geïnstalleerde kernel"
fi

# --- Netwerk
wired=$(ip -4 -o addr show scope global 2>/dev/null | awk '$2 ~ /^en/ {print $2" "$4; exit}')
if [[ -n "$wired" ]]; then
  report OK wired "$wired"
else
  report FAIL wired "geen en*-interface met een IPv4-adres"
fi

if gw=$(ip route show default 2>/dev/null | awk '/^default/ {print "via "$3" op "$5; exit}') && [[ -n "$gw" ]]; then
  report OK route "$gw"
else
  report FAIL route "geen default route"
fi

if timeout 5 getent hosts github.com >/dev/null; then
  report OK dns "github.com wordt opgezocht"
else
  report FAIL dns "github.com is niet op te zoeken"
fi

if timeout 10 curl -fsS -o /dev/null --max-time 8 https://github.com 2>/dev/null; then
  report OK internet "https://github.com antwoordt"
else
  report FAIL internet "https://github.com antwoordt niet"
fi

if ts=$(timeout 5 tailscale status --json 2>/dev/null) &&
   [[ $(jq -r '.BackendState' <<<"$ts") == Running ]]; then
  report OK tailscale "$(jq -r '[.Self.DNSName, (.TailscaleIPs[] | select(test("^[0-9.]+$")))] | join(" ")' <<<"$ts")"
else
  report FAIL tailscale "tailscaled draait niet of is niet verbonden (BackendState: $(jq -r '.BackendState' <<<"${ts:-null}" 2>/dev/null))"
fi

if ss -Htln 'sport = :22' | grep -q .; then
  report OK ssh "luistert op poort 22"
else
  report FAIL ssh "niets luistert op poort 22"
fi

# --- Schijf en swap
read -r pct avail < <(df -P / | awk 'NR==2 {sub("%", "", $5); printf "%s %.0f\n", $5, $4/1048576}')
if (( pct >= DISK_FAIL_PCT )); then
  report FAIL disk "/ is ${pct}% vol, ${avail} GB vrij (faalt vanaf ${DISK_FAIL_PCT}%)"
elif (( pct >= DISK_WARN_PCT )); then
  report WARN disk "/ is ${pct}% vol, ${avail} GB vrij (waarschuwt vanaf ${DISK_WARN_PCT}%)"
else
  report OK disk "/ is ${pct}% vol, ${avail} GB vrij"
fi

swap_kb=$(awk '/^SwapTotal:/ {print $2}' /proc/meminfo)
if (( swap_kb > 0 )); then
  report OK swap "$(( (swap_kb + 524288) / 1048576 )) GB"
else
  report FAIL swap "geen swap actief"
fi

# --- Pending reboot
newest=$(ls /boot/vmlinuz-* 2>/dev/null | sed 's|/boot/vmlinuz-||' | sort -V | tail -n1)
if [[ -e /run/reboot-required ]]; then
  pkgs=$(sort -u /run/reboot-required.pkgs 2>/dev/null | paste -sd' ')
  report FAIL reboot "reboot nodig${pkgs:+ voor: $pkgs}"
elif [[ -n "$newest" && "$newest" != "$(uname -r)" ]]; then
  report FAIL reboot "kernel $(uname -r) draait, $newest is geïnstalleerd"
else
  report OK reboot "geen reboot nodig (kernel $(uname -r))"
fi

# --- LLM-helper (F-017)
if [[ -r "$CONFDIR/llm.conf" ]]; then
  llm_port=$(sed -n 's/^LLM_PORT=//p' "$CONFDIR/llm.conf")
  if h=$(timeout 8 curl -fsS "http://127.0.0.1:${llm_port:-8017}/health" 2>&1); then
    report OK llm "helper antwoordt, model $(jq -r .model <<<"$h")"
  else
    report FAIL llm "helper antwoordt niet op poort ${llm_port:-8017}: $(jq -r '.error // empty' <<<"$h" 2>/dev/null || echo "$h")"
  fi
fi

# --- Gedeployde diensten (F-018): de sync-lus, en per service of compose-repo of hij draait
STATE_DIR=/srv/homelab/state
if [[ -d $STATE_DIR ]] && command -v homelab-deploy >/dev/null; then
  if out=$(timeout 15 homelab-deploy status 2>&1); then
    report OK deploy "sync en laatste deploys in orde"
  else
    report FAIL deploy "$(grep -E 'FOUT|LOOPT|nooit|mislukt' <<<"$out" | head -3 | tr -s ' ' | paste -sd';')"
  fi
  for f in "$STATE_DIR"/*.json; do
    name=$(basename "$f" .json)
    [[ $name == _* ]] && continue
    kind=$(jq -r .kind "$f")
    if [[ $kind == service ]]; then
      if systemctl is-active --quiet "homelab-app-$name.service"; then
        report OK "svc:$name" "homelab-app-$name draait"
      else
        report FAIL "svc:$name" "homelab-app-$name draait niet ($(systemctl is-active "homelab-app-$name.service"))"
      fi
    elif [[ $kind == compose ]]; then
      at=$(jq -r '.running_at // empty' "$f")
      if [[ -z $at ]] || (( $(date +%s) - $(date -d "$at" +%s) > 300 )); then
        report FAIL "svc:$name" "geen recente status van homelab-deploy"
      elif [[ $(jq -r .running "$f") == true ]]; then
        report OK "svc:$name" "$(jq -r .running_detail "$f")"
      else
        report FAIL "svc:$name" "$(jq -r .running_detail "$f")"
      fi
    fi
  done
fi

# --- Task inbox (F-021)
if [[ -f /etc/systemd/system/homelab-inbox.service ]]; then
  inbox_port=$(sed -n 's/^INBOX_PORT=//p' "$CONFDIR/inbox.conf" 2>/dev/null)
  if systemctl is-active --quiet homelab-inbox.service && ss -Htln "sport = :${inbox_port:-8105}" | grep -q .; then
    report OK inbox "homelab-inbox luistert op poort ${inbox_port:-8105}"
  else
    report FAIL inbox "homelab-inbox draait niet ($(systemctl is-active homelab-inbox.service))"
  fi
fi

# --- Backup (F-020): de laatste geslaagde backup, en ruimte op de backupschijf
if [[ -r "$CONFDIR/backup.conf" ]]; then
  # shellcheck source=../config/backup.conf
  source "$CONFDIR/backup.conf"
  if [[ ! -r "$BACKUP_STATUS" ]]; then
    report FAIL backup "nog geen backup gemaakt ($BACKUP_STATUS ontbreekt)"
  else
    last_ok=$(jq -r '.last_ok // empty' "$BACKUP_STATUS")
    if [[ -z $last_ok ]]; then
      report FAIL backup "nog nooit gelukt: $(jq -r '.error // "onbekend"' "$BACKUP_STATUS")"
    else
      age_h=$(( ($(date +%s) - $(date -d "$last_ok" +%s)) / 3600 ))
      if (( age_h >= BACKUP_MAX_AGE_HOURS )); then
        report FAIL backup "laatste geslaagde backup is $age_h uur oud (max. $BACKUP_MAX_AGE_HOURS)"
      elif [[ $(jq -r .ok "$BACKUP_STATUS") != true ]]; then
        report FAIL backup "laatste run mislukt: $(jq -r '.error // "onbekend"' "$BACKUP_STATUS")"
      else
        report OK backup "$(jq -r .file "$BACKUP_STATUS"), $age_h uur oud"
      fi
    fi
  fi
  if [[ -n ${BACKUP_MOUNT:-} ]] && ! mountpoint -q "$BACKUP_MOUNT"; then
    report FAIL backup-disk "backupschijf niet gemount op $BACKUP_MOUNT (USB-HDD niet aangesloten?)"
  elif [[ ! -d "$BACKUP_DIR" ]]; then
    report FAIL backup-disk "$BACKUP_DIR bestaat niet (schijf niet aangesloten?)"
  else
    read -r bpct bfree < <(df -P "$BACKUP_DIR" | awk 'NR==2 {sub("%", "", $5); printf "%s %.0f\n", 100-$5, $4/1048576}')
    if (( bpct < BACKUP_MIN_FREE_PCT )); then
      report FAIL backup-disk "nog ${bpct}% vrij op $BACKUP_DIR (${bfree} GB; min. ${BACKUP_MIN_FREE_PCT}%)"
    else
      report OK backup-disk "${bfree} GB (${bpct}%) vrij op $BACKUP_DIR"
    fi
  fi
fi

exit "$failed"
