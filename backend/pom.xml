<?xml version="1.0" encoding="UTF-8"?>
<!-- homelab inbox backend (H-023 B1). Every version comes from the parent (Spring Boot 4.1.2, which pins the
     plugins and the dependencies) or from the wrapper (Maven 3.9.16, .mvn/wrapper/maven-wrapper.properties). -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>dev.homelab</groupId>
  <artifactId>inbox-backend</artifactId>
  <version>0.1.0</version>
  <name>homelab-inbox-backend</name>
  <description>Spring Boot backend of the homelab inbox, running beside the Python inbox</description>

  <properties>
    <java.version>21</java.version>
    <!-- Not managed by Spring Boot: the one version we pin ourselves (Unix socket for pgjdbc, Q2). -->
    <junixsocket.version>2.11.1</junixsocket.version>
    <!-- Not managed by Spring Boot either: reads the old inbox.db in the one-off import-sqlite command (B5). -->
    <sqlite-jdbc.version>3.50.3.0</sqlite-jdbc.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <!-- Flyway 10+ keeps the PostgreSQL support in its own module. -->
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <!-- PostgreSQL is socket-only (no TCP listener): pgjdbc reaches it through an AF_UNIX socket factory. -->
      <groupId>com.kohlschutter.junixsocket</groupId>
      <artifactId>junixsocket-core</artifactId>
      <version>${junixsocket.version}</version>
      <type>pom</type>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>${sqlite-jdbc.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <!-- H-028 W5a: the stylesheet and fonts the inbox serves under /static/, inside the jar (ui/web/). -->
        <directory>../web</directory>
        <targetPath>ui/web</targetPath>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <!-- H-028 W1: the suite must never start the real Claude, gh, git or ntfy: ProcessCommandRunner refuses to run
             anything while this property is set (the tests pass a fake CommandRunner). -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <inbox.commands.deny>true</inbox.commands.deny>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!-- H-028 W5a: ONE build of the backend together with the UI: `./mvnw -Pui package` runs `npm ci` and `npm run build`
           in ../frontend and puts frontend/dist in the jar under ui/dist/. Without -Pui (CI, tests) there is no npm step. -->
      <id>ui</id>
      <build>
        <resources>
          <resource>
            <directory>src/main/resources</directory>
          </resource>
          <resource>
            <directory>../web</directory>
            <targetPath>ui/web</targetPath>
          </resource>
          <resource>
            <directory>../frontend/dist</directory>
            <targetPath>ui/dist</targetPath>
          </resource>
        </resources>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>npm-ci</id>
                <phase>generate-resources</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>npm</executable>
                  <workingDirectory>../frontend</workingDirectory>
                  <arguments><argument>ci</argument><argument>--ignore-scripts</argument></arguments>
                </configuration>
              </execution>
              <execution>
                <id>npm-build</id>
                <phase>generate-resources</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>npm</executable>
                  <workingDirectory>../frontend</workingDirectory>
                  <arguments><argument>run</argument><argument>build</argument></arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
