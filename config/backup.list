# homelab: wat homelab-backup elke dag bewaart (F-020): de staat die een herbouw uit de repo niet terugbrengt.
# Eén pad of glob per regel. SQLite-bestanden (*.db) worden met de backup-API gekopieerd, zodat ze heel zijn.

# Tailscale: dezelfde machine op het tailnet, zonder opnieuw inloggen.
/var/lib/tailscale/tailscaled.state
# SSH-hostkeys: geen waarschuwing in Windows na een herbouw.
/etc/ssh/ssh_host_*
# SSH-sleutels van de gebruiker, ook die via de homelab-pagina erbij kwamen.
/home/chris/.ssh/authorized_keys
# Claude Code en gh van claude: ingelogd blijven. Plus Claudes geheugen.
/home/claude/.claude/.credentials.json
/home/claude/.claude.json
/home/claude/.claude/projects/*/memory
/home/claude/.config/gh/hosts.yml
# Tokens: deploy (GitHub, read-only), ntfy (melden), heartbeat-URL.
/etc/homelab
# ntfy: gebruikers, wachtwoorden en tokens.
/var/lib/ntfy/user.db
# claude-dashboard: gekoppelde apparaten, certificaat, commands.log.
/home/claude/.local/share/claude-dashboard
# Home Assistant (H-008): devices, scenes, automations, users and its own secrets. Not in git, a rebuild cannot recreate it.
/srv/homelab/data/homeassistant/config
# forge (H-015): its state (idea list, merged features, repo registry, log) and its Claude CLI / gh logins.
/var/lib/forge/state.json
# The mark of changes/0009-forge-reset-memory: without it a restored box would clear the restored state again.
/var/lib/forge/before-reset-0009/done
/var/lib/forge/.claude
/var/lib/forge/.claude.json
/var/lib/forge/.config/gh
# Obsidian second brain: notes, sources and their git history; also holds its own scripts and systemd units.
# Not /srv/obsidian/code-map: bin/code-map.sh regenerates it from the repos.
/srv/obsidian/second-brain
# Logboeken: LLM-gebruik (F-017) en machinewijzigingen (F-019), plus de staat van homelab-admin.
/var/lib/private/llm-helper/usage.db
/var/log/homelab/changes.jsonl
/var/lib/homelab/admin/applied.json
/var/lib/homelab/admin/machine.json
# sdlc-studio (H-013): generated projects and their artifact versions (DynamicUser state).
/var/lib/private/sdlc-studio/*.db
