#!/usr/bin/env python3
"""homelab-inbox: taken voor Claude op de box, vanaf de telefoon (F-021).

  homelab-inbox serve     de pagina (poort INBOX_PORT, alleen jouw Tailscale-login) en de wachtrij; dienst homelab-inbox
  homelab-inbox list      de taken, nieuwste eerst
  homelab-inbox jobs      de jobs (F-022): schema, volgende run, laatste resultaat

Een taak is een repo uit de F-018-lijst plus vrije tekst. Hij draait als het account `inbox` (homelab-inbox-task, via
één sudo-regel): Claude in auto mode, in een eigen werkkopie op branch inbox/<id>, zonder GitHub-toegang. Na afloop
haalt de dienst de commits op als git-bundle (alleen data) en pusht hij ze zelf naar inbox/<id> met zijn eigen
token, en opent hij de PR. Claude kan via de inbox dus niet mergen en niet naar main pushen.

Laatste bericht van Claude: KLAAR: / ANTWOORD: / VRAAG: / GEWEIGERD: (zie SYSTEM_PROMPT), eventueel gevolgd door
een SKILL-VOORSTEL: (F-022), waar de dienst een PR in de homelab-repo van maakt.

Jobs (F-022): bestanden in jobs/ op de branch JOBS_BRANCH van de privé DATA_REPO, gepland in JOB_TIMEZONE. Een lokale job
verzamelt tekst en laat het lokale model (F-017) samenvatten; een Claude-job wordt een inbox-taak met dezelfde rij en
regels, plus een daglimiet (JOB_CLAUDE_CAP). Skills staan in skills/<naam>/SKILL.md op main en komen er alleen via een
PR die de gebruiker merget; homelab-inbox-task zet ze voor elke taak in ~/.claude/skills van inbox.
Geheugen (F-023): voorkeuren, feiten en geschiedenis als bestanden op de branch MEMORY_BRANCH van DATA_REPO; alleen
deze dienst schrijft erop (voor Claude via GEHEUGEN:-blokken onder zijn laatste bericht, voor de gebruiker via de pagina).
Elke taak krijgt de voorkeuren en feiten in zijn systeemprompt en de geschiedenis als map om te doorzoeken.
Instellingen: config/inbox.conf (en deploy.conf, admin.conf). Voor tests: INBOX_FAKE_GITHUB=1 (PR's alleen
loggen, antwoorden uit RUNNER_HOME/fake_github.json, pushen naar REMOTE_<NAAM>-paden; jobs en geheugen:
REMOTE_HOMELAB_DATA), TASK_CMD (in plaats van sudo -u inbox homelab-inbox-task), NTFY_FAKE=1,
INBOX_RUNNER_HOME, REPOS_CONF, OWNER_LOGIN; voor jobs ook OVERVIEW_CMD en LLM_URL; voor het overzicht (F-024)
MONITOR_DIR, DEPLOY_STATE en BACKUP_STATUS.

Overzicht (F-024): / is de homelab-pagina (statuszin, nu bezig met live logs, jobs-tijdlijn, deze week, gezondheid);
stijl, script en lettertypen in web/. Live logs per taak of run in RUNNER_HOME/logs, via /api/live en /api/log.
"""
import argparse
import sys
from pathlib import Path

# The modules live next to this script (bin/homelab_inbox/); also when it is started through a symlink.
sys.path.insert(0, str(Path(__file__).resolve().parent))

from homelab_inbox.config import JOBS, STATUS_NL
from homelab_inbox.helpers import first_line
from homelab_inbox.jobs import RUN_NL, job_runs, load_jobs, run_view
from homelab_inbox.memory import MEMORY, load_memory
from homelab_inbox.pages import local, mem_matches, next_run
from homelab_inbox.server import serve
from homelab_inbox.storage import tasks

# Everything stays reachable as a name of this script too, for tests that load it with SourceFileLoader.
from homelab_inbox.config import *  # noqa: F401,F403
from homelab_inbox.storage import *  # noqa: F401,F403
from homelab_inbox.helpers import *  # noqa: F401,F403
from homelab_inbox.rounds import *  # noqa: F401,F403
from homelab_inbox.router import *  # noqa: F401,F403
from homelab_inbox.briefs import *  # noqa: F401,F403
from homelab_inbox.queue import *  # noqa: F401,F403
from homelab_inbox.github import *  # noqa: F401,F403
from homelab_inbox.jobs import *  # noqa: F401,F403
from homelab_inbox.memory import *  # noqa: F401,F403
from homelab_inbox.overview import *  # noqa: F401,F403
from homelab_inbox.pages import *  # noqa: F401,F403
from homelab_inbox.server import *  # noqa: F401,F403


def main():
    p = argparse.ArgumentParser(prog="homelab-inbox", description="Taken voor Claude op de box (F-021).")
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("serve")
    sub.add_parser("list")
    sub.add_parser("jobs")
    sub.add_parser("memory", help="het geheugen (F-023), eventueel gefilterd").add_argument("zoek", nargs="*")
    a = p.parse_args()
    if a.cmd == "serve":
        serve()
    elif a.cmd == "memory":
        load_memory(fetch=False)
        for m in [m for m in MEMORY if mem_matches(m, [w.lower() for w in a.zoek])]:
            print(f"{m['id']:44} {local(m['changed']):12} {first_line(m['body']).lstrip('# ')}")
    elif a.cmd == "jobs":
        load_jobs(fetch=False)
        for name, job in sorted(JOBS.items()):
            if "error" in job:
                print(f"{name:24} FOUT: {job['error']}")
                continue
            last = job_runs(name, 1)
            print(f"{name:24} {job['model']:6} {job['schedule']:16} volgende {next_run(job):18}"
                  + (f" laatste: {RUN_NL.get(run_view(last[0])[0], '')}" if last else ""))
    else:
        for t in tasks():
            print(f"#{t['id']:<4} {STATUS_NL[t['status']]:18} {t['repo']:18} {first_line(t['text'])}"
                  + (f"  {t['pr_url']}" if t["pr_url"] else ""))


if __name__ == "__main__":
    main()

