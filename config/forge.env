# homelab: template for /etc/forge/env (forge, H-015). scripts/25-forge.sh copies it there once and never overwrites it.
# No secrets here: forge uses the Claude CLI and gh logins of the `forge` account, never a key.
# The unit already sets the first three; uncomment to override. The bind host must stay the Tailscale address.
#FORGE_BIND_HOST=100.85.70.34
#FORGE_PORT=8120
#FORGE_STATE_DIR=/var/lib/forge
# Hard limits (docs/projects.md, forge). They change only by editing this file and restarting the service.
#FORGE_REPO_LIMIT=3
#FORGE_ALLOWANCE_SHARE=40
